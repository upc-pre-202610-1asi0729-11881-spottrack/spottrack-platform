# Copy this file to .env and fill in real values. Never commit the real .env file.

# Spring profile to run: dev or prod
SPRING_PROFILES_ACTIVE=prod

# Database (required for the prod profile; dev profile defaults to local MySQL/XAMPP)
DATABASE_URL=localhost
DATABASE_PORT=3306
DATABASE_NAME=spottrack-platform
DATABASE_USER=root
DATABASE_PASSWORD=

# App server port
PORT=8080

# JWT signing secret (must be long enough for HS512, 512 bits minimum)
JWT_SECRET=

# Stripe secret key (sk_test_... or sk_live_...) and webhook signing secret (whsec_...)
STRIPE_SECRET_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Where Stripe redirects after checkout; override for non-local deployments
STRIPE_SUCCESS_URL=http://localhost:4200/payment/success
STRIPE_CANCEL_URL=http://localhost:4200/payment/cancel
